<!DOCTYPE html>
<html>
 
<head>
    <title>NAP Registration</title>
</head>
 
<body>
    <div class="main">
        <h1>NTN Application Portail</h1>
        <%= image_tag "Logo_NTNTE.png" %>
        <%= build record_form(resource, url: session_path(resource_name)) do |f| %>
        </div>
        <form action="">
            <%= build f.text_field :username, label: "Utilisateur", autofocus: true, autocomplete: "username" %>
            <%= build f.password_field :password, label: "Mot de passe", autocomplete: "current-password" %>
 
            <div class="wrap"> 
            <button type="submit" onclick="solve()"> Entrer </button>
            </div>
        </form>
        <% end %>
    </div>
</body>
 
</html>

