<%= 
  build app_frame(
    title: t("Liste des entretiens"),
    notice:,
    actions: [
    ]
  ) do 
    build [
      index_grid(
        self,
        attributes: reviews.review_context.table_attributes,
        form_layout: "layout-2-columns",
        form: proc do |form|
          build [
            form.text_field(:employee_names_mathrs, label: t("Employé: Nom - Prénom - Mathr")),
            form.text_field(:manager_names_mathrs, label: t("Manager: Nom - Prénom - Mathr")),
          ]
        end,
        actions: [
          proc { |vc, record| vc.reviews.review_context.finish_button(record) },
          proc { |vc, record| vc.reviews.review_context.print_button(record) },
        ]
      )
    ]
  end 
  
%>

