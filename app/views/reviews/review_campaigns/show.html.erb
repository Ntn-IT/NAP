<%= 
  build app_frame(
    title: t("Campagne d'entretien",),
    notice:,
    bind_to: @review_campaign,
    actions: [
      :edit_record_button,
      reviews.review_campaign_context.start_button(@review_campaign),
      reviews.review_campaign_context.finish_button(@review_campaign),
      reviews.review_campaign_context.destroy_button(@review_campaign),
    ]
  ) do 
    build table_attributes(
      bind_to: @review_campaign,
      attributes: reviews.review_campaign_context.table_attributes
    ) 
  end
  
%>

<%= build app_frame(
   title: t("Statistisques campagne"),
   notice:
) do %>

</head>

  <%= build main_content_header do %>

  <% end %>
    <%=
     pie_chart(
      Reviews::Review.group(:status).where(review_campaign_id: @review_campaign.id).count(),
      refresh: 5,
      title: "Taux de réalisation Terminé/En cours"
     )
    %>
    <%= 
      column_chart(
        Reviews::Review.group_by_day(:date).where(review_campaign_id: @review_campaign.id, status: 'finished').count(:status),
        refresh: 5,
        title: "Historique des passations"
      )
      %>
      
      <%= 
      sum=0
      total=Reviews::Review.where(review_campaign_id: @review_campaign.id).count()
      area_chart(
        Reviews::Review.group_by_day(:date).where(review_campaign_id: @review_campaign.id, status: 'finished')
        .count.to_a.sort{|x,y| x[0] <=> y[0]}.map { |x,y| { x => (sum += y)} }.reduce({}, :merge),
        refresh: 5,
        min: 0, max: total,

        title: "Courbe de progression"
      )
      %>
  
  
  <% reviews_finished=Reviews::Review.where(review_campaign_id: @review_campaign.id,status: 'finished')%>

  <!DOCTYPE html>
<html>
<p>
<table>
  <thead>
    <tr>
      <th>Entretiens réalisés</th>
    </tr>
  </thead> 
  <tbody> 
  <% reviews_finished.each do |review_finished| %>
    <tr>
      <td><%="#{review_finished.employee_fname} #{review_finished. employee_lname}"%></td>
    </tr> 
    <% end %>
    
  </tbody>         
</table>
</html>

  <%= build main_content_footer do %>

  <% end %>

<% end %>