        {
          "type": "notation",
          "title": "Est-ce que vous vous estimez motivé ?"
        },
        {
          "type": "notation",
          "title": "Vous sentez-vous reconnu ?"
        },
        {
          "type": "notation",
          "title": "Etes-vous satisfait de vos relations internes (collègues, hiérarchie…) ?"
        },
        {
          "type": "notation",
          "title": "Etes-vous satisfait de l’articulation entre votre vie privée et votre vie professionnelle ?"
        },
        {
          "type": "notation",
          "title": "Comment caractériseriez-vous la communication interne (flash info, ilot…) ?"
        }
      ]
    },
